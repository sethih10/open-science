{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{"type": "command", "command": "python -m fragplace.runtime.policy block-coordinate-edits"}]
      },
      {
        "matcher": "mcp__fragplace__.*",
        "hooks": [{"type": "command", "command": "python -m fragplace.runtime.policy require-checkpoint"}]
      }
    ]
  }
}
