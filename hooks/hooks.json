{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "\"${FRAGPLACE_PYTHON:-${CLAUDE_PLUGIN_ROOT}/.venv/bin/python}\" -m fragplace.runtime.policy block-coordinate-edits"}]
      },
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "\"${FRAGPLACE_PYTHON:-${CLAUDE_PLUGIN_ROOT}/.venv/bin/python}\" -m fragplace.runtime.policy block-self-approval"}]
      },
      {
        "matcher": "mcp__plugin_fragplace_fragplace__.*",
        "hooks": [{"type": "command", "command": "\"${FRAGPLACE_PYTHON:-${CLAUDE_PLUGIN_ROOT}/.venv/bin/python}\" -m fragplace.runtime.policy require-checkpoint"}]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [{"type": "command", "command": "\"${FRAGPLACE_PYTHON:-${CLAUDE_PLUGIN_ROOT}/.venv/bin/python}\" -m fragplace.runtime.policy guard-question"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{"type": "command", "command": "\"${FRAGPLACE_PYTHON:-${CLAUDE_PLUGIN_ROOT}/.venv/bin/python}\" -m fragplace.study.human"}]
      }
    ]
  }
}
